  "narrative": {
    "northStar": "暖纸面上的文件工作台",
    "overview": "页面本身保持安静，颜色主要来自文件自己。左侧目录树与存储刻度尺，右侧白色文件区；只有浅色一种外观，与统一通行证的浅色悬浮窗同系。完整规范见 DESIGN.md。",
    "keyCharacteristics": [
      "存储条画成徽标里的那把刻度尺",
      "文件夹是蜜色的，文件按类型着色",
      "选中像荧光笔划过",
      "主操作松绿，危险操作深红，珊瑚色只属于爱心",
      "工具栏只有上传和新建两个带文字的按钮"
    ],
    "rules": [
      "全站最小字号 14px",
      "正文与占位文字对比度不低于 4.5:1",
      "阴影带暖色，不用纯灰",
      "不使用毛玻璃和装饰性渐变",
      "不写行内 style，不引用外部资源"
    ],
    "dos": [
      "让文件名和文件类型最显眼",
      "新增操作优先放进已有菜单",
      "不可恢复的操作先确认并写清后果",
      "文案用成员听得懂的话",
      "在 1440、820、390、320 四个宽度检查横向溢出"
    ],
    "donts": [
      "不恢复深色外观",
      "不把珊瑚色用于按钮或链接",
      "不在每一行重复摆放文字操作链接",
      "不在页面上写运维术语",
      "不使用 550、650 等中间字重"
    ]
